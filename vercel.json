{
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{frontend/**,backend/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "installCommand": "npm ci --omit=dev --no-audit --no-fund",
  "outputDirectory": "public"
}
