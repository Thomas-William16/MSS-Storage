NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/scout_storage?replicaSet=rs0
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# For separately hosted, same-site frontend/backend HTTPS production deployments:
# COOKIE_SAME_SITE=lax
# For cross-site deployments use none (HTTPS required; browser third-party cookie policy applies).
COOKIE_SAME_SITE=lax
# Set only behind a known reverse proxy, e.g. Render's single proxy hop.
TRUST_PROXY=0
